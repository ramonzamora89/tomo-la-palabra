# Copy to .env.local for local dev. Never commit the real values —
# .env/.env.local are gitignored. In CI these live as GitHub Secrets
# (see .github/workflows/*.yml).

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://tomolapalabra.com
NEXT_PUBLIC_AD_PROVIDER=adsense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- Videos section (YouTube Data API v3) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Content pipeline (see pipeline/README.md) ---
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
# The full service-account JSON key, as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
# OAuth client (Desktop app type) + refresh token for the real Google
# account — needed only because service accounts have no Drive storage
# quota on personal (non-Workspace) Gmail. Get the refresh token by running
# `npm run pipeline:google-oauth-setup` once. See pipeline/src/lib/googleClients.ts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_FOLDER_ENTREVISTAS_ID=
DRIVE_FOLDER_BORRADORES_ID=
DRIVE_FOLDER_PUBLICAR_ID=
DRIVE_FOLDER_ARCHIVO_ID=
DRIVE_LEDGER_SHEET_ID=
